# Copy to deploy/.env for `docker compose -f deploy/docker-compose.yml`.
# Names match compose interpolation; containers also set HARNESYS_* aliases.

# Published host port → container SERVER_PORT 47474
PORT=47474

# Published web UI port → container HARNESYS_WEB_PORT 8080
WEB_PORT=8080

# Web proxy upstream for /api and /ws (compose service name by default)
UPSTREAM=http://host:47474

# Public origin for webhook URLs (optional)
# PUBLIC_URL=https://harnesys.example.com

# Opt-in SearXNG profile: docker compose --profile search up -d
# SEARXNG_PORT=8888
# SEARXNG_SECRET=change-me
