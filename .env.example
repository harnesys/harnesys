# Local / process env contract (Stage 1).
# Copy values into the shell, direnv, or apps/server/.env as needed.
# Prefer HARNESYS_* names; legacy aliases still work where noted.

# --- API port (single source of truth) ---
# SERVER_PORT is read by: apps/server (application.yml), the dev stand
# (scripts/dev.ts), the vite /api proxy (apps/webui/vite.config.ts) and the
# web proxy upstream (apps/webui/server/config.ts). Change it in one place.
NODE_ENV=local

APP_NAME=Harnesys
APP_DESCRIPTION="Harness fleet control plane"
APP_VERSION=0.1.0

SERVER_HOST=0.0.0.0
SERVER_PORT=47474
# Loaded via apps/server/src/config/application.yml → AppConfig.harnesys.*
# Home override comes via HARNESYS_HOME (see dev stand section below).
# PUBLIC_URL=https://harnesys.example.com
# HARNESYS_PROXY_SECRET=

# --- web proxy (apps/webui/server, harnesys-web) ---
# Own port and static dir of the production web proxy; upstream derives from
# SERVER_PORT unless explicitly overridden here.
HARNESYS_WEB_PORT=8080
HARNESYS_WEB_STATIC=
# HARNESYS_UPSTREAM=http://127.0.0.1:47474

# Google connector: no env credentials needed. Create your own Google Cloud app and
# paste its client id/secret in the web UI: Settings → Connectors → Google.

# --- install / release helpers ---
# HARNESYS_REPO=harnesys/harnesys
# HARNESYS_PREFIX=$HOME/.local/bin

# --- local dev stand (`bun run dev`, scripts/dev.ts) ---
# API port follows SERVER_PORT unless DEV_SERVER_PORT is set (dev-only).
# Dev UI and the dev home stay out of the way of the installed host's data.
# DEV_SERVER_PORT=47473
# DEV_UI_PORT=5173
# DEV_HARNEYSYS_HOME=~/.harnesys-dev

# --- desktop updater (CI / local signed builds) ---
# TAURI_SIGNING_PRIVATE_KEY=
