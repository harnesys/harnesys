{
  "id": "harnesys.telegram-bot",
  "version": "1.3.0",
  "platform": 1,
  "title": "Telegram bot",
  "description": "Direct-message bot: a personal Telegram bot whose private chats mirror Harnesys threads one-to-one. Chats pair through a pair code (send /start in the DM, then enter the code in this settings page), agent replies come back as the bot with drafts, HITL asks and attachments. Telegram tools for agents live in the separate Telegram tools add-on. This add-on binds its own telegram-bot account with its own BotFather token; never share one bot token between this add-on and Telegram groups (getUpdates returns 409 for two pollers on one token).",
  "runtime": {
    "entry": "dist/index.js",
    "profile": "trusted"
  },
  "activation": "resident",
  "permissions": [
    {
      "id": "http.fetch",
      "scope": {
        "hosts": [
          "api.telegram.org"
        ]
      },
      "reason": "Call the Telegram Bot API"
    },
    {
      "id": "accounts.use",
      "scope": {
        "connections": [
          "telegram-bot"
        ]
      },
      "reason": "Resolve the bot token bound to the telegram-bot connection owned by this add-on"
    },
    {
      "id": "worker",
      "reason": "Keep the long-polling worker that receives updates and sends them to the bridge"
    },
    {
      "id": "lifecycle.resident",
      "reason": "Stay running to keep long polling the Bot API"
    },
    {
      "id": "bridge.inbound",
      "reason": "Deliver inbound chat messages and media into Harnesys threads"
    },
    {
      "id": "files.read",
      "reason": "Read workspace files to send them to Telegram"
    },
    {
      "id": "runs.read",
      "reason": "Find the active run to stop in reply to /stop"
    },
    {
      "id": "threads.compact",
      "reason": "Compact the paired thread history in reply to /compact"
    },
    {
      "id": "usage.read",
      "reason": "Report token and cost usage in reply to /stats"
    },
    {
      "id": "skills.read",
      "reason": "List skills available to the paired agent in reply to /skills"
    }
  ],
  "connections": [
    {
      "id": "telegram-bot",
      "label": "Telegram bot (direct messages)",
      "accountKinds": [
        "telegram-bot"
      ],
      "cardinality": "one",
      "optional": true
    }
  ],
  "data": {
    "migrations": "migrations",
    "quotaMb": 32
  },
  "contributions": [
    {
      "id": "config",
      "family": "config",
      "descriptor": {
        "fields": [
          {
            "key": "commands",
            "label": "Commands",
            "type": "boolean",
            "required": false,
            "default": true,
            "help": "Handle /start, /help, /id, /stop, /compact, /stats and /skills before bridging text to the thread"
          },
          {
            "key": "media_limit_mb",
            "label": "Inbound media limit, MB",
            "type": "number",
            "required": false,
            "default": 5,
            "help": "Attachments larger than this are bridged as a note instead of bytes (max 8)"
          }
        ]
      }
    },
    {
      "id": "channel",
      "family": "transport",
      "descriptor": {
        "provider": "telegram",
        "title": "Telegram bot",
        "connection": "telegram-bot",
        "capabilities": {
          "threads": true,
          "edit": true,
          "typing": true,
          "attachments": true,
          "topics": true,
          "reactions": false,
          "readReceipts": false
        },
        "limits": {
          "textMax": 4096
        }
      }
    },
    {
      "id": "poller",
      "family": "worker",
      "descriptor": {
        "id": "poller",
        "title": "Updates poller",
        "autostart": true,
        "restart": "on-failure"
      }
    },
    {
      "id": "main",
      "family": "view",
      "descriptor": {
        "id": "main",
        "title": "Telegram bot",
        "sections": [
          {
            "type": "status"
          },
          {
            "type": "capabilities"
          },
          {
            "type": "permissions"
          },
          {
            "type": "connections",
            "connections": [
              "telegram-bot"
            ]
          },
          {
            "type": "config"
          },
          {
            "type": "jobs"
          },
          {
            "type": "form",
            "title": "Pair a chat",
            "fields": [
              {
                "key": "code",
                "label": "Pair code",
                "type": "text",
                "required": true,
                "help": "Send /start in a direct message to this bot and enter the 8-character code it replies with"
              }
            ],
            "submit": {
              "route": "/pair"
            }
          },
          {
            "type": "table",
            "title": "Paired chats",
            "source": {
              "route": "/chats"
            },
            "columns": [
              {
                "key": "id",
                "label": "Chat",
                "format": "text"
              },
              {
                "key": "status",
                "label": "Status",
                "format": "badge"
              },
              {
                "key": "user",
                "label": "Telegram user",
                "format": "text"
              },
              {
                "key": "threadId",
                "label": "Thread",
                "format": "text"
              },
              {
                "key": "updatedAt",
                "label": "Updated",
                "format": "datetime"
              }
            ],
            "rowActions": [
              {
                "id": "unbind",
                "label": "Unpair",
                "route": {
                  "route": "/chats/:id/unbind",
                  "params": {
                    "id": "id"
                  }
                },
                "confirm": "Unpair this chat? The bot stops reading it until it is paired again.",
                "destructive": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": "chats",
      "family": "route",
      "descriptor": {
        "id": "chats",
        "method": "GET",
        "path": "/chats",
        "role": "member"
      }
    },
    {
      "id": "pair",
      "family": "route",
      "descriptor": {
        "id": "pair",
        "method": "POST",
        "path": "/pair",
        "role": "member"
      }
    },
    {
      "id": "unbind",
      "family": "route",
      "descriptor": {
        "id": "unbind",
        "method": "POST",
        "path": "/chats/:id/unbind",
        "role": "member"
      }
    }
  ],
  "icon": "assets/icon.svg",
  "color": "#229ED9"
}
