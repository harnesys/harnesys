{
  "id": "starter",
  "version": "0.1.0",
  "entry": "./src/index.ts",
  "execution": "process",
  "assets": ["./contents"],
  "contributions": [
    {
      "id": "starter.hello",
      "family": "tool",
      "capabilities": ["tools:call"],
      "descriptor": {
        "name": "hello_addon",
        "description": "Greet someone by name.",
        "input": { "name": "string" }
      }
    },
    {
      "id": "starter.skills",
      "family": "content",
      "capabilities": ["content:read"],
      "descriptor": {
        "dir": "./contents/skills",
        "kinds": ["skill"]
      }
    },
    {
      "id": "starter.section",
      "family": "view",
      "capabilities": ["ui:render"],
      "descriptor": {
        "container": "sidebar",
        "kind": "section",
        "label": "Starter",
        "icon": "puzzle"
      }
    },
    {
      "id": "starter.strip",
      "family": "hook",
      "capabilities": ["events:emit"],
      "descriptor": {
        "on": "PreModelCall",
        "effect": "update_input",
        "order": 100
      }
    },
    {
      "id": "starter.status",
      "family": "route",
      "capabilities": ["routes:serve"],
      "descriptor": {
        "method": "GET",
        "path": "/status"
      }
    }
  ]
}
