{
  "id": "harnesys.telegram-groups",
  "version": "1.7.0",
  "platform": 1,
  "title": "Telegram groups",
  "description": "Group and community bot: the bot is added to group chats and forum topics and mirrors their messages into Harnesys threads. Groups register themselves with /start or /join (admin or privacy-mode verification via getChatMember), an admin connects a group or topic to a thread on this settings page, and who answers is the thread responder mode (auto: the pinned agent answers every message; mention: only @mentions and replies). All messages of a connected group or topic mirror into its thread either way. This add-on binds its own telegram-bot account with its own BotFather token; never share one bot token between this add-on and the Telegram bot add-on (getUpdates returns 409 for two pollers on one token).",
  "runtime": {
    "entry": "dist/index.js",
    "profile": "trusted"
  },
  "activation": "resident",
  "permissions": [
    {
      "id": "http.fetch",
      "scope": {
        "hosts": [
          "api.telegram.org"
        ]
      },
      "reason": "Call the Telegram Bot API"
    },
    {
      "id": "accounts.use",
      "scope": {
        "connections": [
          "telegram-bot"
        ]
      },
      "reason": "Resolve the bot token bound to the telegram-bot connection owned by this add-on"
    },
    {
      "id": "worker",
      "reason": "Keep the long-polling worker that receives updates and sends them to the bridge"
    },
    {
      "id": "lifecycle.resident",
      "reason": "Stay running to keep long polling the Bot API"
    },
    {
      "id": "bridge.inbound",
      "reason": "Deliver inbound group messages and media into Harnesys threads"
    },
    {
      "id": "files.read",
      "reason": "Read workspace files to send them to Telegram"
    },
    {
      "id": "runs.read",
      "reason": "List runs in the bound thread so /stop can find the active one"
    },
    {
      "id": "runs.dispatch",
      "reason": "Cancel the active run for /stop (runs.cancel is gated behind this permission)"
    },
    {
      "id": "threads.create",
      "reason": "Create the thread a group or topic is connected to from the settings page"
    },
    {
      "id": "threads.read",
      "reason": "Read the connected thread title and responder mode for the routing card"
    },
    {
      "id": "threads.write",
      "reason": "Set the thread responder mode chosen in the connect form"
    },
    {
      "id": "agents.read",
      "reason": "List workspace agents for the connect form and the routing card"
    },
    {
      "id": "bindings.write",
      "reason": "Bind and unbind the add-on transport channels to threads from the settings page"
    },
    {
      "id": "threads.compact",
      "reason": "Compact the bound thread history for /compact"
    },
    {
      "id": "usage.read",
      "reason": "Read token usage and cost for the bound thread for /stats"
    },
    {
      "id": "skills.read",
      "reason": "List the skills available to the thread agent for /skills"
    }
  ],
  "connections": [
    {
      "id": "telegram-bot",
      "label": "Telegram bot (groups)",
      "accountKinds": [
        "telegram-bot"
      ],
      "cardinality": "one",
      "optional": true
    }
  ],
  "data": {
    "migrations": "migrations",
    "quotaMb": 32
  },
  "contributions": [
    {
      "id": "config",
      "family": "config",
      "descriptor": {
        "fields": [
          {
            "key": "attribution",
            "label": "Sender attribution",
            "type": "boolean",
            "required": false,
            "default": true,
            "help": "Prefix bridged messages with the sender and group name"
          },
          {
            "key": "commands",
            "label": "Commands",
            "type": "boolean",
            "required": false,
            "default": true,
            "help": "Handle /start, /join, /help, /id, /agent, /stop, /stats, /skills and /compact in groups"
          },
          {
            "key": "media_limit_mb",
            "label": "Inbound media limit, MB",
            "type": "number",
            "required": false,
            "default": 5,
            "help": "Attachments larger than this are bridged as a note instead of bytes (max 8)"
          },
          {
            "key": "inbox_max_batch",
            "label": "Messages per agent turn",
            "type": "number",
            "required": false,
            "default": 20,
            "help": "How many queued group messages are handed to the agent in one turn; the rest wait for the next turn"
          },
          {
            "key": "inbox_max_chars",
            "label": "Characters per agent turn",
            "type": "number",
            "required": false,
            "default": 3000,
            "help": "Upper bound of the batched text sent to the agent; the newest messages are kept and the omitted older ones are counted in the header"
          },
          {
            "key": "inbox_max_backlog",
            "label": "Queued messages per chat",
            "type": "number",
            "required": false,
            "default": 50,
            "help": "Oldest messages are dropped beyond this limit while the agent is busy"
          },
          {
            "key": "inbox_ttl_sec",
            "label": "Queue message lifetime, seconds",
            "type": "number",
            "required": false,
            "default": 3600,
            "help": "Queued messages older than this are dropped instead of being replayed to the agent"
          },
          {
            "key": "reply_mode",
            "label": "Reply anchoring",
            "type": "select",
            "required": false,
            "default": "auto",
            "options": [
              {
                "value": "auto",
                "label": "Reply to the last message of the batch once"
              },
              {
                "value": "always",
                "label": "Reply to the last message of the batch while it is fresh"
              },
              {
                "value": "never",
                "label": "Post without a reply"
              }
            ],
            "help": "Whether the agent's answer is posted as a Telegram reply to the message that triggered it"
          },
          {
            "key": "reply_window_sec",
            "label": "Reply window, seconds",
            "type": "number",
            "required": false,
            "default": 900,
            "help": "An answer posted later than this after the last queued message is sent without a reply"
          }
        ]
      }
    },
    {
      "id": "channel",
      "family": "transport",
      "descriptor": {
        "provider": "telegram",
        "title": "Telegram groups",
        "connection": "telegram-bot",
        "capabilities": {
          "threads": true,
          "edit": true,
          "typing": true,
          "attachments": true,
          "topics": true,
          "reactions": false,
          "readReceipts": false
        },
        "limits": {
          "textMax": 4096
        }
      }
    },
    {
      "id": "poller",
      "family": "worker",
      "descriptor": {
        "id": "poller",
        "title": "Updates poller",
        "autostart": true,
        "restart": "on-failure"
      }
    },
    {
      "id": "main",
      "family": "view",
      "descriptor": {
        "id": "main",
        "title": "Telegram groups",
        "sections": [
          {
            "type": "status"
          },
          {
            "type": "capabilities"
          },
          {
            "type": "permissions"
          },
          {
            "type": "connections",
            "connections": [
              "telegram-bot"
            ]
          },
          {
            "type": "config"
          },
          {
            "type": "jobs"
          },
          {
            "type": "table",
            "title": "Registered chats",
            "source": {
              "route": "/chats"
            },
            "columns": [
              {
                "key": "title",
                "label": "Group",
                "format": "text"
              },
              {
                "key": "kind",
                "label": "Kind",
                "format": "badge"
              },
              {
                "key": "status",
                "label": "Status",
                "format": "badge"
              },
              {
                "key": "id",
                "label": "Chat id",
                "format": "copy"
              },
              {
                "key": "updatedAt",
                "label": "Updated",
                "format": "datetime"
              }
            ]
          },
          {
            "type": "table",
            "title": "Routing",
            "source": { "route": "/bindings" },
            "columns": [
              { "key": "target", "label": "Target", "format": "text" },
              { "key": "agent", "label": "Agent", "format": "text" },
              { "key": "thread", "label": "Thread", "format": "text" },
              { "key": "mode", "label": "Mode", "format": "badge" },
              { "key": "status", "label": "Status", "format": "badge" },
              { "key": "channel", "label": "Channel", "format": "copy" },
              { "key": "updatedAt", "label": "Updated", "format": "datetime" }
            ],
            "rowActions": [
              {
                "id": "unbind",
                "label": "Unbind",
                "route": { "route": "/unbind?channel=:channel" },
                "confirm": "Stop mirroring this target into its thread? The thread itself is kept.",
                "destructive": true
              }
            ]
          },
          {
            "type": "form",
            "title": "Connect a group or topic",
            "fields": [
              {
                "key": "chat",
                "label": "Group",
                "type": "text",
                "required": true,
                "placeholder": "Pick a discovered group",
                "optionsFrom": {
                  "kind": "addonRoute",
                  "route": "chats",
                  "valueKey": "id",
                  "labelKey": "title"
                },
                "widget": {
                  "kind": "combobox"
                },
                "help": "Groups the bot has seen; add the bot to a group or send /start there to discover it"
              },
              {
                "key": "topic",
                "label": "Forum topic",
                "type": "text",
                "required": false,
                "placeholder": "Whole group",
                "optionsFrom": {
                  "kind": "addonRoute",
                  "route": "topics",
                  "valueKey": "topicId",
                  "labelKey": "title",
                  "dependsOn": [
                    "chat"
                  ]
                },
                "widget": {
                  "kind": "combobox"
                },
                "help": "Pick a discovered topic, or type a name to create a new one (the bot must be a group admin). Leave empty to connect the whole group. Topic names appear as soon as the bot sees the topic being created or edited, or any message posted in it."
              },
              {
                "key": "mode",
                "label": "Responder mode",
                "type": "select",
                "required": false,
                "default": "auto",
                "options": [
                  {
                    "value": "auto",
                    "label": "Agent answers every message"
                  },
                  {
                    "value": "mention",
                    "label": "Agents answer only @mentions and replies"
                  }
                ],
                "help": "Who answers in the connected thread — the same setting as the thread settings page. All messages of the connected group or topic are mirrored into the thread either way; this only decides whether unaddressed messages trigger the agent."
              },
              {
                "key": "agentId",
                "label": "Agent",
                "type": "select",
                "required": true,
                "optionsFrom": {
                  "kind": "agents"
                },
                "help": "The agent answers in the connected thread (auto mode) or joins it as a member (mention mode)"
              },
              {
                "key": "title",
                "label": "Thread title",
                "type": "text",
                "required": false,
                "help": "Defaults to the group and topic names"
              }
            ],
            "submit": {
              "route": "/connect"
            }
          }
        ]
      }
    },
    {
      "id": "chats",
      "family": "route",
      "descriptor": {
        "id": "chats",
        "method": "GET",
        "path": "/chats",
        "role": "member"
      }
    },
    {
      "id": "topics",
      "family": "route",
      "descriptor": {
        "id": "topics",
        "method": "GET",
        "path": "/topics",
        "role": "member"
      }
    },
    {
      "id": "connect",
      "family": "route",
      "descriptor": {
        "id": "connect",
        "method": "POST",
        "path": "/connect",
        "role": "member"
      }
    },
    {
      "id": "unbind",
      "family": "route",
      "descriptor": {
        "id": "unbind",
        "method": "POST",
        "path": "/unbind",
        "role": "member"
      }
    },
    {
      "id": "bindings",
      "family": "route",
      "descriptor": {
        "id": "bindings",
        "method": "GET",
        "path": "/bindings",
        "role": "member"
      }
    }
  ],
  "icon": "assets/icon.svg",
  "color": "#229ED9"
}
