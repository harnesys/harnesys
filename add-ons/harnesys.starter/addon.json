{
  "id": "harnesys.starter",
  "version": "1.0.0",
  "platform": 1,
  "title": "Starter add-on",
  "description": "Reference implementation of the add-on platform: config with a secret, tools, a periodic job, a trigger kind, routes with :params, and a host-event hook. Runtime profile is 'trusted' on purpose: trust comes from the builtin source (add-ons/ in the monorepo), not from the manifest, and 'trusted' keeps the package runnable on hosts without an OS sandbox mechanism.",
  "runtime": { "entry": "dist/index.js", "profile": "trusted" },
  "activation": "lazy",
  "permissions": [
    {
      "id": "http.fetch",
      "scope": { "hosts": ["api.github.com"] },
      "reason": "Fetch a public GitHub user profile for the github_user tool"
    },
    {
      "id": "events.subscribe",
      "scope": { "patterns": ["thread.created"] },
      "reason": "Observe thread creation to demonstrate hook delivery into the add-on"
    },
    {
      "id": "trigger",
      "reason": "Run trigger instances and fire automation runs from the starter.tick trigger"
    }
  ],
  "connections": [
    {
      "id": "github",
      "label": "GitHub installation",
      "accountKinds": ["github-installation"],
      "cardinality": "one",
      "optional": true
    }
  ],
  "data": { "migrations": "migrations", "quotaMb": 16 },
  "contributions": [
    {
      "id": "config",
      "family": "config",
      "descriptor": {
        "fields": [
          {
            "key": "default_github_login",
            "label": "Default GitHub login",
            "type": "text",
            "required": false,
            "placeholder": "octocat",
            "help": "Used by the github_user tool when the call does not pass a login"
          },
          {
            "key": "greeting",
            "label": "Greeting phrase",
            "type": "text",
            "required": false,
            "default": "hello from config"
          },
          {
            "key": "api_note",
            "label": "Secret note",
            "type": "secret",
            "required": false,
            "help": "Stored in the host secret store, returned only through secrets.get"
          }
        ]
      }
    },
    {
      "id": "pack",
      "family": "tool-pack",
      "descriptor": {
        "name": "starter",
        "title": "Starter tools",
        "description": "Tools that demonstrate tool calling, host config, secrets and auth-injected HTTP",
        "connection": "github",
        "tools": [
          {
            "name": "ping",
            "description": "Echoes a message back and records the call in the add-on log and database",
            "effect": "read",
            "idempotent": true,
            "inputSchema": {
              "type": "object",
              "properties": { "message": { "type": "string", "description": "Text to echo" } }
            },
            "outputSchema": {
              "type": "object",
              "properties": { "pong": { "type": "string" }, "at": { "type": "string" } },
              "required": ["pong", "at"]
            }
          },
          {
            "name": "github_user",
            "description": "Fetches a GitHub user profile; uses the bound github account when one is linked and reports needs_setup otherwise",
            "effect": "read",
            "idempotent": true,
            "inputSchema": {
              "type": "object",
              "properties": { "login": { "type": "string", "description": "GitHub login; falls back to the default_github_login config value" } }
            }
          }
        ]
      }
    },
    {
      "id": "heartbeat",
      "family": "job",
      "descriptor": {
        "id": "heartbeat",
        "title": "Heartbeat",
        "schedule": { "everySec": 60 },
        "catchUp": "none",
        "defaultEnabled": true
      }
    },
    {
      "id": "tick",
      "family": "trigger",
      "descriptor": {
        "kind": "starter.tick",
        "title": "Starter tick",
        "description": "Fires once when the trigger instance starts, with deduplication on replay",
        "configFields": [
          { "key": "label", "label": "Label", "type": "text", "required": false }
        ]
      }
    },
    {
      "id": "items-list",
      "family": "route",
      "descriptor": { "id": "items-list", "method": "GET", "path": "/items", "role": "member" }
    },
    {
      "id": "items-create",
      "family": "route",
      "descriptor": {
        "id": "items-create",
        "method": "POST",
        "path": "/items",
        "role": "member",
        "requestSchema": {
          "type": "object",
          "properties": { "text": { "type": "string", "minLength": 1 } },
          "required": ["text"]
        }
      }
    },
    {
      "id": "item-get",
      "family": "route",
      "descriptor": { "id": "item-get", "method": "GET", "path": "/items/:id", "role": "member" }
    },
    {
      "id": "thread-created",
      "family": "hook",
      "descriptor": { "id": "thread-created", "on": { "event": "thread.created" } }
    }
  ]
}
