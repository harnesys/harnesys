# Host process env. Bun loads this file; application.yml substitutes ${VAR:-}.
# App code reads AppConfig via @Configuration(), not process.env.
# Full contract: repo-root .env.example
# Copy to apps/server/.env (gitignored).

NODE_ENV=local

APP_NAME=Harnesys
APP_DESCRIPTION=Harness fleet control plane
APP_VERSION=0.1.0

SERVER_HOST=0.0.0.0
SERVER_PORT=47474

# Optional overrides (empty → defaults in adapters)
# HARNESYS_HOME=
# HARNESYS_MASTER_KEY=

# Google connector: no env credentials needed. Create your own Google Cloud app and
# paste its client id/secret in the web UI: Settings → Connectors → Google.

# GitHub connector. Setup guide: docs/connectors/github-app-setup.md
# App: type GitHub App (not OAuth App). Callback http://127.0.0.1:47474/api/integrations/github/callback.
# Permissions: Contents RO, Issues RW, Pull requests RW, Actions RW. Webhook off locally.
# PRIVATE_KEY goes on ONE line with literal \n escapes (awk -v ORS='\\n' '1' app.pem).
# HARNESYS_GITHUB_APP_APP_ID=
# HARNESYS_GITHUB_APP_PRIVATE_KEY=
# HARNESYS_GITHUB_APP_CLIENT_ID=
# HARNESYS_GITHUB_APP_CLIENT_SECRET=
# HARNESYS_GITHUB_APP_WEBHOOK_SECRET=
# HARNESYS_GITHUB_APP_SLUG=
