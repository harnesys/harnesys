{
  "name": "Planner",
  "role": "planner",
  "budget": {
    "maxSteps": 80,
    "deadlineMs": 1200000,
    "policy": "ask"
  },
  "capabilities": {
    "files": {},
    "plan": {},
    "threads": {},
    "core": {}
  },
  "permissions": {
    "fs.write": "ask",
    "process": "ask",
    "network": "ask",
    "mcp": "ask"
  },
  "graph": {
    "nodes": {
      "start": {
        "type": "core:start"
      },
      "think": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages"
      },
      "act": {
        "type": "tool:call",
        "calls": "$output.toolCalls",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "end": {
        "type": "core:end"
      }
    },
    "edges": [
      {
        "from": "start",
        "to": "think"
      },
      {
        "from": "think",
        "to": "act",
        "when": "$output.finishReason = \"tool-calls\""
      },
      {
        "from": "think",
        "to": "end"
      },
      {
        "from": "act",
        "to": "think"
      }
    ]
  },
  "color": "yellow"
}
