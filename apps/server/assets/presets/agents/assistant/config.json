{
  "name": "Assistant",
  "role": "chief-of-staff",
  "skills": [
    "agent-creator",
    "workspace-ops",
    "find-skills"
  ],
  "budget": {
    "maxSteps": 400,
    "deadlineMs": 3600000,
    "policy": "ask"
  },
  "capabilities": {
    "files": {},
    "shell": {
      "spec": {
        "blocklist": [
          "sudo *",
          "rm -rf ~",
          "git push --force",
          "kubectl delete *",
          "docker rm -f *",
          "shutdown",
          "reboot",
          "crontab -r",
          "npm publish"
        ]
      }
    },
    "web": {},
    "skills": {},
    "issues": {},
    "manager": {},
    "lsp": {},
    "mcp": {},
    "plan": {},
    "agents": {},
    "threads": {},
    "scheduler": {},
    "webhook": {},
    "episodic-memory": {},
    "semantic-memory": {},
    "knowledge-memory": {},
    "pin-memory": {},
    "core": {}
  },
  "permissions": {
    "fs.write": "ask",
    "process": "ask",
    "network": "ask",
    "mcp": "ask"
  },
  "graph": {
    "nodes": {
      "start": {
        "type": "core:start"
      },
      "think": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages"
      },
      "act": {
        "type": "tool:call",
        "calls": "$output.toolCalls",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "end": {
        "type": "core:end"
      },
      "spawn": {
        "type": "control:spawn",
        "calls": "$state.spawns",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "handoff": {
        "type": "control:handoff",
        "agentId": "$state.handoffAgentId",
        "input": "$input"
      },
      "map": {
        "type": "control:map",
        "items": "$state.mapItems",
        "enter": "map_item",
        "body": [
          "map_item",
          "map_done"
        ],
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        },
        "timeoutMs": 600000,
        "onTimeout": "partial"
      },
      "map_item": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages",
        "tools": []
      },
      "map_done": {
        "type": "control:yield",
        "value": "$output.text"
      },
      "wait": {
        "type": "control:wait",
        "untilMs": "$state.waitUntilMs"
      }
    },
    "edges": [
      {
        "from": "start",
        "to": "think"
      },
      {
        "from": "think",
        "to": "act",
        "when": "$output.finishReason = \"tool-calls\""
      },
      {
        "from": "think",
        "to": "end"
      },
      {
        "from": "act",
        "to": "spawn",
        "when": "exists($state.spawns) && length($state.spawns) > 0"
      },
      {
        "from": "act",
        "to": "handoff",
        "when": "exists($state.handoffAgentId)"
      },
      {
        "from": "act",
        "to": "map",
        "when": "exists($state.mapItems) && length($state.mapItems) > 0"
      },
      {
        "from": "act",
        "to": "wait",
        "when": "exists($state.waitUntilMs)"
      },
      {
        "from": "act",
        "to": "think"
      },
      {
        "from": "spawn",
        "to": "handoff",
        "when": "exists($state.handoffAgentId)"
      },
      {
        "from": "spawn",
        "to": "think"
      },
      {
        "from": "map",
        "to": "think"
      },
      {
        "from": "wait",
        "to": "think"
      },
      {
        "from": "map_item",
        "to": "map_done"
      },
      {
        "from": "handoff",
        "to": "end"
      }
    ]
  },
  "color": "blue"
}
