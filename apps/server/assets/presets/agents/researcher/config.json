{
  "name": "Researcher",
  "role": "researcher",
  "skills": [
    "agent-creator"
  ],
  "budget": {
    "maxSteps": 250,
    "deadlineMs": 3600000,
    "policy": "ask"
  },
  "capabilities": {
    "files": {},
    "web": {},
    "plan": {},
    "agents": {},
    "threads": {},
    "episodic-memory": {},
    "knowledge-memory": {},
    "semantic-memory": {},
    "pin-memory": {},
    "core": {}
  },
  "permissions": {
    "fs.write": "ask",
    "process": "ask",
    "network": "allow",
    "mcp": "ask"
  },
  "graph": {
    "nodes": {
      "start": {
        "type": "core:start"
      },
      "think": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages"
      },
      "act": {
        "type": "tool:call",
        "calls": "$output.toolCalls",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "end": {
        "type": "core:end"
      },
      "spawn": {
        "type": "control:spawn",
        "calls": "$state.spawns",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "map": {
        "type": "control:map",
        "items": "$state.mapItems",
        "enter": "map_item",
        "body": [
          "map_item",
          "map_done"
        ],
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        },
        "timeoutMs": 600000,
        "onTimeout": "partial"
      },
      "map_item": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages",
        "tools": []
      },
      "map_done": {
        "type": "control:yield",
        "value": "$output.text"
      },
      "wait": {
        "type": "control:wait",
        "untilMs": "$state.waitUntilMs"
      }
    },
    "edges": [
      {
        "from": "start",
        "to": "think"
      },
      {
        "from": "think",
        "to": "act",
        "when": "$output.finishReason = \"tool-calls\""
      },
      {
        "from": "think",
        "to": "end"
      },
      {
        "from": "act",
        "to": "spawn",
        "when": "exists($state.spawns) && length($state.spawns) > 0"
      },
      {
        "from": "act",
        "to": "map",
        "when": "exists($state.mapItems) && length($state.mapItems) > 0"
      },
      {
        "from": "act",
        "to": "wait",
        "when": "exists($state.waitUntilMs)"
      },
      {
        "from": "act",
        "to": "think"
      },
      {
        "from": "spawn",
        "to": "think"
      },
      {
        "from": "map",
        "to": "think"
      },
      {
        "from": "wait",
        "to": "think"
      },
      {
        "from": "map_item",
        "to": "map_done"
      }
    ]
  },
  "color": "pink"
}
