{
  "name": "Coder",
  "role": "coder",
  "skills": [
    "issue-ops"
  ],
  "budget": {
    "maxSteps": 300,
    "deadlineMs": 2700000,
    "policy": "ask"
  },
  "toolOutput": {
    "redactSecrets": true
  },
  "capabilities": {
    "files": {},
    "shell": {
      "spec": {
        "blocklist": [
          "sudo *",
          "rm -rf ~",
          "git push *",
          "kubectl delete *",
          "docker rm -f *",
          "shutdown",
          "reboot",
          "crontab -r",
          "npm publish"
        ]
      }
    },
    "issues": {},
    "lsp": {},
    "plan": {},
    "pin-memory": {},
    "core": {},
    "agents": {
      "disabledTools": [
        "agents_handoff",
        "agents_create",
        "agents_create_subagent",
        "agents_update",
        "agents_delete"
      ]
    }
  },
  "permissions": {
    "fs.write": "allow",
    "process": "allow",
    "network": "ask",
    "mcp": "ask"
  },
  "graph": {
    "nodes": {
      "start": {
        "type": "core:start"
      },
      "think": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages"
      },
      "act": {
        "type": "tool:call",
        "calls": "$output.toolCalls",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "end": {
        "type": "core:end"
      },
      "spawn": {
        "type": "control:spawn",
        "calls": "$state.spawns",
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        }
      },
      "map": {
        "type": "control:map",
        "items": "$state.mapItems",
        "enter": "map_item",
        "body": [
          "map_item",
          "map_done"
        ],
        "concurrency": "parallel",
        "barrier": {
          "policy": "all"
        },
        "timeoutMs": 600000,
        "onTimeout": "partial"
      },
      "map_item": {
        "type": "llm:generate",
        "prompt": "main",
        "messages": "$state.messages",
        "tools": []
      },
      "map_done": {
        "type": "control:yield",
        "value": "$output.text"
      },
      "wait": {
        "type": "control:wait",
        "untilMs": "$state.waitUntilMs"
      }
    },
    "edges": [
      {
        "from": "start",
        "to": "think"
      },
      {
        "from": "think",
        "to": "act",
        "when": "$output.finishReason = \"tool-calls\""
      },
      {
        "from": "think",
        "to": "end"
      },
      {
        "from": "act",
        "to": "spawn",
        "when": "exists($state.spawns) && length($state.spawns) > 0"
      },
      {
        "from": "act",
        "to": "map",
        "when": "exists($state.mapItems) && length($state.mapItems) > 0"
      },
      {
        "from": "act",
        "to": "wait",
        "when": "exists($state.waitUntilMs)"
      },
      {
        "from": "act",
        "to": "think"
      },
      {
        "from": "spawn",
        "to": "think"
      },
      {
        "from": "map",
        "to": "think"
      },
      {
        "from": "wait",
        "to": "think"
      },
      {
        "from": "map_item",
        "to": "map_done"
      }
    ]
  },
  "color": "green"
}
