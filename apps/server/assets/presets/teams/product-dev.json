{
  "name": "Product Dev",
  "description": "Jarvis coordinates Coder and Reviewer on a shared issue board: board rules dispatch work, daily digest reports progress.",
  "tags": ["team", "dev"],
  "roles": [
    {
      "roleKey": "jarvis",
      "name": "Jarvis",
      "agentRef": "harnesys/jarvis",
      "budgetUsdDaily": 5,
      "requiresModel": true,
      "capabilitiesExtra": ["manager"]
    },
    {
      "roleKey": "coder",
      "name": "Coder",
      "agentRef": "harnesys/coder",
      "budgetUsdDaily": 10,
      "requiresModel": true
    },
    {
      "roleKey": "reviewer",
      "name": "Reviewer",
      "agentRef": "harnesys/reviewer",
      "budgetUsdDaily": 5,
      "requiresModel": true
    }
  ],
  "board": {
    "name": "Product Dev",
    "statuses": [
      {
        "key": "backlog",
        "label": "Backlog",
        "category": "backlog",
        "order": 0,
        "color": "#94a3b8",
        "isEntry": true
      },
      {
        "key": "todo",
        "label": "Todo",
        "category": "started",
        "order": 1,
        "color": "#60a5fa",
        "isEntry": false
      },
      {
        "key": "in_progress",
        "label": "In Progress",
        "category": "started",
        "order": 2,
        "color": "#818cf8",
        "isEntry": false
      },
      {
        "key": "in_review",
        "label": "In Review",
        "category": "started",
        "order": 3,
        "color": "#fbbf24",
        "isEntry": false
      },
      {
        "key": "done",
        "label": "Done",
        "category": "finished",
        "order": 4,
        "color": "#34d399",
        "isEntry": false
      },
      {
        "key": "cancelled",
        "label": "Cancelled",
        "category": "cancelled",
        "order": 5,
        "color": "#9ca3af",
        "isEntry": false
      }
    ],
    "rules": [
      {
        "trigger": { "type": "status_entered", "statusKey": "in_progress" },
        "conditions": [],
        "actions": [{ "type": "assign_agent", "roleKey": "coder" }],
        "position": 0,
        "enabled": true
      },
      {
        "trigger": { "type": "status_entered", "statusKey": "in_review" },
        "conditions": [],
        "actions": [{ "type": "assign_agent", "roleKey": "reviewer" }],
        "position": 1,
        "enabled": true
      }
    ]
  },
  "digest": {
    "cronDefault": "0 9 * * *",
    "roleKey": "jarvis",
    "detail": "Daily digest: manager_pulse, then open issues by status, what moved since the last digest, failed runs, today's spend per agent against daily budget, approvals waiting on the owner. Finish with decisions needed from the owner."
  }
}
