{
  "name": "@harnesys/sdk",
  "version": "1.4.0",
  "description": "Add-on SDK for Harnesys: manifest, contributions, JSON-RPC protocol, permissions, defineAddon, host client and a testing fake host.",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harnesys/harnesys.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/harnesys/harnesys/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/harnesys/harnesys/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack": "rm -rf dist && tsc -p tsconfig.build.json && npm pack",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
